# ---------------------------------------------------------------------------
# Ravan — single-server deployment.
#
# Copy to .env and fill in, or let ./install.sh write it for you (it generates
# every secret below with `openssl rand`). Never commit the resulting .env.
# ---------------------------------------------------------------------------

# --- where this install lives ------------------------------------------------
# The domain must already point at this server: Caddy obtains a Let's Encrypt
# certificate for it on first start. Use `localhost` for a local trial run.
RAVAN_DOMAIN=ravan.example.com
RAVAN_TLS_EMAIL=admin@example.com
# Public IPv4 of the server. Only needed when the host is behind a 1:1 NAT and
# LiveKit/coturn cannot detect the address themselves.
RAVAN_PUBLIC_IP=

APP_NAME=Ravan
# Default interface language: fa | en | tr
APP_LOCALE=fa
# emergency | alert | critical | error | warning | notice | info | debug
LOG_LEVEL=warning
LOG_LEVEL_SERVICES=INFO

# --- generated secrets (./install.sh fills these) ----------------------------
APP_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=
REDIS_PASSWORD=
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TURN_SECRET=
RAVAN_ANALYSIS_TOKEN=
RAVAN_WEBHOOK_SECRET=
RAVAN_ASR_TOKEN=

# --- database ----------------------------------------------------------------
DB_DATABASE=ravan
DB_USERNAME=ravan
# Roughly 60% of the RAM you want MySQL to use.
MYSQL_BUFFER_POOL=512M

# --- speech recognition ------------------------------------------------------
# faster_whisper = fully local, nothing leaves the server (recommended).
# openai         = sends session audio to OpenAI. The behaviour is disclosed in
#                  the transcription consent text; do not enable it unless that
#                  disclosure matches your legal basis.
RAVAN_ASR_BACKEND=faster_whisper
# tiny | base | small | medium | large-v3. large-v3 needs ~4 GB RAM at int8.
RAVAN_ASR_MODEL=large-v3
# int8 (CPU, default) | int8_float16 | float16 (needs a GPU build)
RAVAN_ASR_COMPUTE_TYPE=int8
# Set false to build a smaller image when you only use the openai backend.
RAVAN_ASR_INSTALL_LOCAL=true

# --- clinical assistant (optional) -------------------------------------------
# none | openai | anthropic. `none` disables the assistant; the observational
# analysis pipeline works either way and never calls an external model.
RAVAN_LLM_PROVIDER=none
RAVAN_LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# How long the analysis service keeps a session in memory after its last frame.
RAVAN_SESSION_TTL_S=14400

# --- payments ----------------------------------------------------------------
# sandbox | zarinpal
RAVAN_PAYMENT_GATEWAY=sandbox
RAVAN_PLATFORM_FEE_RATIO=0.15
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# --- mail --------------------------------------------------------------------
# log = write to the container log instead of sending (fine for a trial).
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=no-reply@ravan.example.com

# --- first run ---------------------------------------------------------------
# true seeds demo accounts and sample data. Leave false on a real install;
# the signal catalog and consent texts are always seeded either way.
RAVAN_SEED=false
