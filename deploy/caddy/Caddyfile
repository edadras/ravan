# ---------------------------------------------------------------------------
# Ravan edge. One domain fronts everything:
#
#   /                 Flutter web bundle (SPA)
#   /api/*            Laravel (php-fpm over FastCGI)
#   /storage/*        Laravel public storage (shared volume)
#   /reverb/*         Laravel Reverb  (presence + live events, WebSocket)
#   /analysis/*       analysis service (derived feature frames, WebSocket)
#   /rtc*             LiveKit signalling (WebSocket) — media goes direct/TURN
#
# TLS: Caddy provisions and renews a Let's Encrypt certificate automatically.
# Set RAVAN_DOMAIN=localhost in .env for a local run (Caddy then self-signs).
#
# The PHP code is NOT on Caddy's filesystem: FastCGI is addressed with an
# explicit root so php-fpm resolves the script inside its own container.
# ---------------------------------------------------------------------------

{
	email {$RAVAN_TLS_EMAIL:admin@localhost}
}

{$RAVAN_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The camera and microphone are used in-page; nothing is embedded cross-origin.
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=()"
		-Server
	}

	# ---- Laravel Reverb (broadcast WebSocket)
	handle /reverb/* {
		uri strip_prefix /reverb
		reverse_proxy reverb:8080
	}

	# ---- analysis service: the patient's browser streams derived numbers here.
	# Frames arrive at ~15 Hz for the whole session, so the timeouts are long.
	handle /analysis/* {
		uri strip_prefix /analysis
		reverse_proxy analysis:8100 {
			transport http {
				read_timeout 6h
				write_timeout 6h
			}
		}
	}

	# ---- LiveKit signalling. `/rtc` is LiveKit's own signal path.
	handle /rtc* {
		reverse_proxy livekit:7880 {
			transport http {
				read_timeout 6h
				write_timeout 6h
			}
		}
	}

	# ---- Laravel public storage (avatars, clinician documents)
	handle /storage/* {
		root * /srv/storage/public
		uri strip_prefix /storage
		file_server
	}

	# ---- Laravel API. Every /api/* path is a front-controller request.
	handle /api/* {
		rewrite * /index.php
		reverse_proxy backend:9000 {
			transport fastcgi {
				root /app/public
				split .php
			}
		}
	}

	# ---- Flutter web bundle, with SPA fallback
	handle {
		root * /srv/web
		# Hashed build artefacts and the vendored MediaPipe assets are immutable.
		@immutable path /vendor/* /assets/* /canvaskit/* *.wasm *.task
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
